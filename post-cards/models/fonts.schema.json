{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hat-im.github.io/post-cards/models/fonts.schema.json",
  "title": "Postcards — Fonts",
  "description": "post-cards/data/theme/fonts.json. Selectable handwriting fonts offered on the create page. postcards.json's font field references an id here.",
  "type": "object",
  "required": ["fonts"],
  "additionalProperties": false,
  "properties": {
    "fonts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "family"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "family": { "type": "string", "minLength": 1, "description": "CSS font-family value." }
        }
      }
    }
  }
}
