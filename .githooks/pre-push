#!/bin/sh
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

python3 tools/validate.py

# Keeps shared/last-updated.json in sync with when changes are actually
# pushed. Runs pre-push (not pre-commit) and amends the timestamp onto the
# commit about to be pushed, rather than creating a separate commit for it.

tz=$(date +%z)
tz_colon=$(printf '%s' "$tz" | sed -E 's/([+-][0-9]{2})([0-9]{2})/\1:\2/')
timestamp=$(date "+%Y-%m-%dT%H:%M:%S")$tz_colon

printf '{"timestamp": "%s"}\n' "$timestamp" > shared/last-updated.json
git add shared/last-updated.json
git commit --amend --no-edit --no-verify
