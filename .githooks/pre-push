#!/bin/sh
# Keeps shared/last-updated.json in sync with the latest content commit.
# Folds the update into the commit being pushed (via amend) instead of
# round-tripping through a GitHub Actions workflow.

set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# Only touch main; other branches pass through untouched.
pushing_main=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/heads/main) pushing_main=1 ;;
    esac
done

[ "$pushing_main" = "1" ] || exit 0

timestamp=$(git log -1 --format=%cI -- . ':!shared/last-updated.json')
new_content=$(printf '{"timestamp": "%s"}\n' "$timestamp")
old_content=$(cat shared/last-updated.json 2>/dev/null || true)

if [ "$new_content" != "$old_content" ]; then
    printf '%s' "$new_content" > shared/last-updated.json
    git add shared/last-updated.json
    git commit --amend --no-edit --no-verify --quiet
    echo "pre-push: updated shared/last-updated.json and amended HEAD"
fi
